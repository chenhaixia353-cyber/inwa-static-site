# Baidu Tongji (百度统计) site ID, from https://tongji.baidu.com
# Leave empty to keep the tracking script out of the build.
PUBLIC_BAIDU_ID=

# Tencent Cloud COS, used by `npm run deploy`.
# The CAM key needs cos:GetBucket, cos:HeadObject, cos:PutObject and
# cos:DeleteObject on the bucket.
COS_BUCKET=ispace-1517883677
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=

# Set to false to keep the files in the bucket that are no longer part of
# the build. The default is true.
COS_CLEAN=true
