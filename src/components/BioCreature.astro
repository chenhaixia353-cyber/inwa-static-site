---
interface Props {
  variant?: 'line' | 'pixel' | 'circuit';
  contained?: boolean;
  host?: boolean;
}

const { variant = 'line', contained = false, host = false } = Astro.props;
---

<div
  class:list={['bio-creature', { 'is-contained': contained }]}
  data-bio-creature
  data-variant={variant}
  data-creature-host={host ? '' : undefined}
  aria-hidden="true"
>
  <svg viewBox="0 0 60 42" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" data-variant="line">
    <g class="bio-legs">
      <path class="bio-leg" d="M20 30 L18 40" />
      <path class="bio-leg" d="M28 31 L26 41" />
      <path class="bio-leg" d="M36 31 L38 41" />
      <path class="bio-leg" d="M43 30 L45 40" />
    </g>
    <g class="bio-body">
      <path d="M12 24 C12 15 20 11 28 11 C37 11 44 15 44 23 C44 30 37 33 28 33 C19 33 12 30 12 24 Z" />
      <path class="bio-tail" d="M12 22 C6 21 3 16 5 12" />
      <circle cx="48" cy="19" r="9" />
      <circle cx="50" cy="17" r="1.9" fill="currentColor" stroke="none" />
      <path d="M52 10 L56 4" />
    </g>
  </svg>

  <svg viewBox="0 0 14 10" fill="currentColor" shape-rendering="crispEdges" data-variant="pixel">
    <g class="bio-legs">
      <rect class="bio-leg" x="3" y="8" width="2" height="2" />
      <rect class="bio-leg" x="9" y="8" width="2" height="2" />
    </g>
    <g class="bio-body">
      <path
        fill-rule="evenodd"
        d="M9 1h4v4H9z M2 5h10v3H2z M0 6h2v1H0z M11 2h1v1H11z"
      />
    </g>
  </svg>

  <svg viewBox="0 0 60 44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" data-variant="circuit">
    <g class="bio-legs">
      <path class="bio-leg" d="M22 26 L15 32 L12 40" />
      <path class="bio-leg" d="M27 27 L25 34 L27 41" />
      <path class="bio-leg" d="M34 27 L37 34 L35 41" />
      <path class="bio-leg" d="M39 25 L46 31 L49 39" />
    </g>
    <g class="bio-body">
      <path class="bio-antenna" d="M30 12 L30 7 L21 7 L17 11" />
      <rect class="bio-node" x="-3" y="-3" width="6" height="6" transform="translate(17 11) rotate(45)" />
      <circle cx="30" cy="20" r="8" />
      <circle class="bio-core" cx="30" cy="20" r="3" fill="currentColor" stroke="none" />
      <circle cx="33.5" cy="16.5" r="1.5" fill="currentColor" stroke="none" />
    </g>
  </svg>
</div>

<script>
  const VARIANTS = ['line', 'pixel', 'circuit'];

  interface Critter {
    el: HTMLElement;
    x: number;
    y: number;
    dir: number;
    timer: number;
    paused: boolean;
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function variantFromUrl(fallback: string): string {
    const param = new URLSearchParams(window.location.search).get('creature');
    return param && VARIANTS.includes(param) ? param : fallback;
  }

  function bounds(el: HTMLElement) {
    const width = el.offsetWidth || 56;
    const height = el.offsetHeight || 40;
    const parent = el.offsetParent as HTMLElement | null;
    if (!parent) {
      return {
        minX: 14,
        maxX: window.innerWidth - width - 14,
        minY: 14,
        maxY: window.innerHeight - height - 14,
        originX: 0,
        originY: 0,
      };
    }
    const rect = parent.getBoundingClientRect();
    const originX = rect.left + parent.clientLeft;
    const originY = rect.top + parent.clientTop;
    return {
      minX: originX + 14,
      maxX: originX + parent.clientWidth - width - 14,
      minY: originY + 14,
      maxY: originY + parent.clientHeight - height - 14,
      originX,
      originY,
    };
  }

  function place(critter: Critter, x: number, y: number, animate: boolean) {
    const box = bounds(critter.el);
    if (!animate) critter.el.style.transition = 'none';
    critter.el.style.transform = `translate3d(${x - box.originX}px, ${y - box.originY}px, 0) scaleX(${critter.dir})`;
    critter.x = x;
    critter.y = y;
  }

  function schedule(critter: Critter, delay: number) {
    critter.timer = window.setTimeout(() => walk(critter), delay);
  }

  function walk(critter: Critter) {
    if (critter.paused || document.hidden) return;
    const box = bounds(critter.el);
    const spanX = Math.max(0, box.maxX - box.minX);
    const spanY = Math.max(0, box.maxY - box.minY);
    const targetX = box.minX + Math.random() * spanX;
    const targetY = box.minY + Math.random() * spanY;
    const dx = targetX - critter.x;
    const dy = targetY - critter.y;
    if (Math.hypot(dx, dy) < 70) {
      schedule(critter, 500 + Math.random() * 900);
      return;
    }
    if (Math.abs(dx) > 12) critter.dir = dx > 0 ? 1 : -1;
    const duration = Math.min(5200, Math.max(1400, Math.hypot(dx, dy) * 9));
    critter.el.style.transition = `transform ${duration}ms cubic-bezier(0.45, 0.05, 0.55, 0.95)`;
    place(critter, targetX, targetY, true);
    critter.el.classList.add('is-walking');
    critter.timer = window.setTimeout(() => {
      critter.el.classList.remove('is-walking');
      schedule(critter, 1200 + Math.random() * 4200);
    }, duration + 40);
  }

  function start(el: HTMLElement) {
    const critter: Critter = {
      el,
      x: 0,
      y: 0,
      dir: Math.random() > 0.5 ? 1 : -1,
      timer: 0,
      paused: false,
    };
    const box = bounds(el);
    place(critter, box.minX + Math.random() * Math.max(0, box.maxX - box.minX), box.minY + Math.random() * Math.max(0, box.maxY - box.minY), false);
    if (!reduceMotion.matches) schedule(critter, 400 + Math.random() * 1200);
    return critter;
  }

  const critters: Critter[] = Array.from(document.querySelectorAll<HTMLElement>('[data-bio-creature]')).map((el) => {
    const fallback = el.dataset.variant ?? 'line';
    const variant = el.closest('[data-creature-host]') ? variantFromUrl(fallback) : fallback;
    el.dataset.variant = variant;
    return start(el);
  });

  let awakeTimer = 0;
  window.addEventListener('pointermove', () => {
    critters.forEach((critter) => critter.el.classList.add('is-awake'));
    window.clearTimeout(awakeTimer);
    awakeTimer = window.setTimeout(() => {
      critters.forEach((critter) => critter.el.classList.remove('is-awake'));
    }, 2600);
  });

  document.addEventListener('visibilitychange', () => {
    critters.forEach((critter) => {
      window.clearTimeout(critter.timer);
      critter.paused = document.hidden;
      if (!document.hidden && !reduceMotion.matches) schedule(critter, 900);
    });
  });

  window.addEventListener('resize', () => {
    critters.forEach((critter) => {
      const box = bounds(critter.el);
      place(critter, Math.min(Math.max(critter.x, box.minX), box.maxX), Math.min(Math.max(critter.y, box.minY), box.maxY), false);
    });
  });
</script>
