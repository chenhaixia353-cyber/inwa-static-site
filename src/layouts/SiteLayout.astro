---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = 'INWA SPACE — Independent Creative Studio',
  description = 'INWA SPACE creates visual identities, cultural spaces and brand experiences.',
  bodyClass = '',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f8f6" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
