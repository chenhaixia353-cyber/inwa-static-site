---
import { getCollection } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL;

const cases = await getCollection('cases');

const disciplineDefinitions = [
  { title: '展陈设计', titleEn: 'EXHIBITION DESIGN' },
  { title: '标识设计', titleEn: 'SIGNAGE DESIGN' },
  { title: '商业空间', titleEn: 'COMMERCIAL SPACE' },
  { title: '装置设计', titleEn: 'INSTALLATION DESIGN' },
  { title: '包装设计', titleEn: 'PACKAGING DESIGN' },
];

// The business areas are counted from the case collection so the numbers stay
// in step with the projects that are actually published.
const disciplines = disciplineDefinitions.map((definition) => {
  const related = cases.filter(({ data }) => data.category === definition.title);
  const tagCounts = new Map<string, number>();
  related.forEach(({ data }) => {
    data.services.forEach((service) => {
      tagCounts.set(service, (tagCounts.get(service) ?? 0) + 1);
    });
  });

  return {
    ...definition,
    count: related.length,
    tags: [...tagCounts.entries()]
      .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'))
      .slice(0, 4)
      .map(([service]) => service),
  };
});
---

<SiteLayout
  title="关于 INWA SPACE｜北京独立设计机构"
  description="INWA SPACE 是一家位于北京的综合性设计机构，以向善之心、匠心之技，聚焦展陈设计、标识设计、装置设计、商业空间与包装设计。"
  canonicalPath="about/"
  bodyClass="page-about"
>
  <SiteHeader />
  <main id="top" class="about-page">
    <section class="about-hero section-pad" aria-labelledby="about-title">
      <p class="eyebrow">INWA SPACE <span>/</span> ABOUT US</p>
      <h1 id="about-title">向善设计，匠心营造<span>。</span></h1>
      <div class="about-hero-bottom">
        <p>DESIGN WITH MEANING.</p>
        <span>BEIJING · EST. 2010</span>
      </div>
    </section>

    <section class="about-intro section-pad" aria-labelledby="intro-title">
      <div class="about-section-label">
        <span>01</span>
        <p class="eyebrow">WHO WE ARE</p>
      </div>
      <div class="about-intro-copy">
        <h2 id="intro-title">好的设计，<br />不仅被看见，更能够被感知。</h2>
        <p>
          INWA SPACE 是一个综合性设计机构，聚焦平面与空间、文化与商业的深度融合，擅长以当代设计语汇激活东方美学与在地基因，为客户创造具备情感共鸣、体验深度与长效商业价值的设计作品。我们相信，好的设计不仅被看见，更能够被感知。
        </p>
        <p>
          我们致力于探索空间与人、环境之间的关系，以当代设计语言融合东方审美与在地文化，持续创造具有情绪感、体验感与长期价值的空间作品。我们专注于多维度空间设计实践，关注空间中的内容叙事、尺度、光线和材料，通过设计重构人与场所的连接，让空间不仅满足功能，更成为情感与文化表达的载体。
        </p>
        <p>
          我们坚持跨领域协同与整体化设计思维，融合建筑、视觉、艺术与数字媒介，以简洁而富有辨识度的设计语言，为商业空间、文化空间、公共空间及品牌展示提供具有时代感的解决方案。
        </p>
      </div>
    </section>

    <section class="about-approach section-pad" aria-labelledby="approach-title">
      <p class="eyebrow">HOW WE THINK</p>
      <h2 id="approach-title">向善，是我们设计的起点。<br />匠心，是我们营造的底色。</h2>
      <div class="value-grid">
        <article class="value-block">
          <h3>向善 <span>WITH GOODWILL</span></h3>
          <p>
            每一处空间，都应回应真实的人与真实的生活。我们关注空间中的内容叙事、尺度、光线与材料，通过设计重构人与场所的连接，让空间不仅满足功能，更成为情感与文化表达的载体。
          </p>
        </article>
        <article class="value-block">
          <h3>匠心 <span>WITH CRAFT</span></h3>
          <p>
            INWA SPACE 坚持跨领域协同与整体化设计思维，以严谨的设计流程、规范的图纸体系与扎实的落地把控，保证概念到实现的一致品质。简洁而富有辨识度的设计语言背后，是对材料、工艺与造价的精准管理——言必有据，行必有果，是我们对职业的承诺。
          </p>
        </article>
      </div>
    </section>

    <section class="about-services section-pad" aria-labelledby="services-title">
      <div class="about-section-label">
        <span>02</span>
        <p class="eyebrow">WHAT WE DO</p>
      </div>
      <div class="about-services-content">
        <h2 id="services-title">从策略到落地，<br />让想法走进真实世界。</h2>
        <p class="services-lead">
          业务领域：展陈设计、标识设计、装置设计、商业空间、包装设计等综合性设计服务。
        </p>
        <div class="discipline-list">
          {disciplines.map((discipline, index) => (
            <a class="discipline-row" href={`${base}#work`}>
              <span class="discipline-number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{discipline.title}</h3>
              <p class="discipline-title-en">{discipline.titleEn}</p>
              <p class="discipline-tags">{discipline.tags.join(' · ')}</p>
              <span class="discipline-count">{discipline.count} 个项目</span>
              <span class="discipline-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="about-cta section-pad">
      <p class="eyebrow">SELECTED WORK</p>
      <a href={`${base}#work`}>我们做过的案例 <span>↗</span></a>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
