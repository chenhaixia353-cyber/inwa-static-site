---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { getCollection, render } from 'astro:content';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const caseAssetsDirectory = fileURLToPath(new URL('../../../public/assets/cases', import.meta.url));
  const cases = await getCollection('cases');
  return cases.map((entry) => {
    const galleryDirectory = join(caseAssetsDirectory, entry.id);
    const galleryFiles = existsSync(galleryDirectory)
      ? readdirSync(galleryDirectory)
          .filter((file) => /^gallery-\d+\.(?:jpe?g|png|gif|webp|avif)$/i.test(file))
          .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
      : [];

    return { params: { slug: entry.id }, props: { entry, galleryFiles } };
  });
}

const { entry, galleryFiles } = Astro.props;
const { Content } = await render(entry);
const { title, titleEn, category, cover, alt, client, year } = entry.data;
const base = import.meta.env.BASE_URL;
const detailImagePath = galleryFiles[0]
  ? `${base}assets/cases/${entry.id}/${galleryFiles[0]}`
  : `${base}${cover.replace(/^\/+/, '')}`;
const galleryImages = galleryFiles.slice(1).map((file: string, index: number) => ({
  src: `${base}assets/cases/${entry.id}/${file}`,
  alt: `${title} 项目图片 ${index + 1}`,
}));
---

<SiteLayout title={`${title} — INWA SPACE`} description={`${title}，${titleEn}。INWA SPACE 项目案例。`}>
  <SiteHeader />
  <main id="top" class="project-page">
    <figure class="project-cover">
      <img src={detailImagePath} alt={alt} fetchpriority="high" />
    </figure>
    <section class="project-intro">
      <a class="back-link" href={`${base}#work`}>← 返回项目选集</a>
      <p class="eyebrow">{category} / {client}{year ? ` / ${year}` : ''}</p>
      <h1>{title} <span>{titleEn}</span></h1>
    </section>
    <section class="project-information">
      <div class="section-heading">
        <h2>PROJECT</h2>
        <span>{client}</span>
      </div>
      <div class="project-content">
        <p class="project-category">{category}</p>
        <div class="prose"><Content /></div>
      </div>
    </section>
    {galleryImages.length > 0 && (
      <section class="project-gallery" aria-label={`${title} 项目图片`}>
        {galleryImages.map((image, index) => (
          <figure class="project-gallery-item">
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              decoding="async"
              fetchpriority={index === 0 ? 'high' : 'auto'}
            />
          </figure>
        ))}
      </section>
    )}
    <section class="project-more section-pad">
      <a class="text-link" href={`${base}#work`}>更多项目 <span>↗</span></a>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
